# Placeholder values only, no real host or credential ever belongs in this file.
# Copy this file to local/phase0/config.env and fill in real values there.
# local/phase0/config.env is gitignored (see .gitignore, local/) and never committed.

# Hostname or IP address of the Windows test machine.
WINDOWS_HOST=192.0.2.10

# TCP port of the Appium server on the Windows host.
APPIUM_PORT=4723
# Base path in front of the Appium HTTP API, empty if the server listens at
# the root. /status is appended to this path for the health check.
APPIUM_PATH=

# TCP port of the Robot Framework Remote Library (XML-RPC) on the Windows host.
ROBOT_REMOTE_PORT=8270

# SSH access to the Windows host, used only for the local baseline run in
# measure_runtime.py (P0-05). Leave empty to fall back to a manually
# measured local duration instead.
SSH_USER=
SSH_KEY_PATH=

# The already working test invocation command from each project, exactly as
# it runs today. The placeholder {WINDOWS_HOST} is replaced with the target
# host by the phase0 scripts; the same value is also exported as the
# WINDOWS_HOST environment variable for commands that read it that way.
APPIUM_TESTCASE_CMD=
ROBOT_TESTCASE_CMD=
